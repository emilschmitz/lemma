    "ship_hi": {"kind": "date_shift", "of": "ship_lo", "amount": 1, "unit": "year"},
    "disc_lo": {"kind": "decimal_range", "lo": "0.01", "hi": "0.08"},
    "disc_hi": {"kind": "decimal_shift", "of": "disc_lo", "amount": "0.02"},
    "quantity": {"kind": "choice", "values": ["24", "25"]}
