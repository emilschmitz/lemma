# LEGACY: settings of the imperative / overnight / OpenRouter path only (research_loop/harness.py, db_extension/run_optimizer.py copy this file
# into the environment with setdefault). Everything that shapes a container run -- agent timeout, data mode, submit-ends-session, the Verus
# wall, DuckDB limits, caps, egress, dirty-tree policy -- lives in lemma.toml at the repo root (python -m lemma_config dump); keys that moved
# there are NOT repeated here. Removed as dead: DEFAULT_ROW_LIMIT, AGENT_WEB_SEARCH, AGENT_DOCS_MOUNT, AGENT_SUBMIT_ONLY_MEASURE.
# A container run overwrites USE_AGENT_DOCKER, AGENT_IMAGE, AGENT_CMD, AGENT_ENV, LEMMA_AGENT_BACKEND and LEMMA_RESEARCH_LOG itself, so the values below do not apply to it.
COMPILE_TIMEOUT_SEC=180

# Attempt `verus` on generated MethodSpec (spec.rs).
ENABLE_VERUS_VERIFY=1

# When 1 (default): verify failure or missing verus → pipeline FAILURE (no silent SUCCESS).
# Set 0 only for local exec-only perf hacking.
REQUIRE_PROOF=1

# --- Agent / GenDB primitives (see agents/PRIMITIVES.md) ---
# If 1, transpile may emit scalar template run_query body; else skeleton for agent.
ENABLE_TEMPLATES=0
# Expose parallel TRUSTED externs (par_sum_u64, par_filter_sum_u64).
LEMMA_ENABLE_PARALLEL=0
# Speed Trusted menu: core hashset/probe/zone + par_*; trust result ≡ serial wrapping spec.
LEMMA_FAST_TRUSTEDS=0
# Vector-friendly filter+sum (build crate with --features vector_scan).
LEMMA_ENABLE_VECTOR_SCAN=0
# Spill-aware hash build (build crate with --features spill_hash).
LEMMA_ENABLE_SPILL_HASH=0
# Estimated HashSet bytes before spill stub activates (1 GiB default).
LEMMA_HASH_SPILL_BYTES=1073741824
# Column loader: lemma_columnar (plain Vec) | duckdb_like (dict strings + zone maps).
LEMMA_LOAD_FORMAT=lemma_columnar
# Bridge flag: load via DuckDB extension (stub; extension work elsewhere).
LEMMA_LOAD_FROM_DUCKDB=0
# Attach aggregate stats / zone maps to agent context.json.
LEMMA_AGENT_STATS=1
# Attach hardware profile to agent context.json.
LEMMA_AGENT_HARDWARE=1
# Host injects DuckDB EXPLAIN/SUMMARIZE into agent profile when duckdb is installed.
LEMMA_AGENT_DUCK_EXPLAIN=1

# --- OpenRouter agent sandbox (see db_extension/AGENT.md) ---
# Backend: openrouter (default) | cli (legacy Cursor Agent CLI in Docker)
LEMMA_AGENT_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Container network: 0 = off (default). GenDB agents had web search; we default restrictive.
AGENT_NETWORK=0
AGENT_WORKLOAD_HINT=1
AGENT_IMAGE=lemma-agent:latest
AGENT_MAX_TURNS=40

# --- Legacy CLI agent (LEMMA_AGENT_BACKEND=cli; see research_loop/AGENT_SANDBOX.md) ---
# Docker: network none + allowlisted API egress (EgressBridge) + MCP sock.
USE_AGENT_DOCKER=0
# --approve-mcps: required or lemma-host stays "not loaded (needs approval)" in fresh workspaces
# Prompt via stdin (not argv) — large MethodSpec excerpts exceed ARG_MAX with "$(cat PROMPT.txt)".
AGENT_CMD=agent -p --force --trust --approve-mcps --model grok-4.7-high --output-format stream-json --stream-partial-output < PROMPT.txt
AGENT_ENV=CURSOR_API_KEY
# Host credentials dir mounted read-only at /root/.cursor (default: ~/.cursor)
# AGENT_CREDENTIALS_DIR=
# Egress profile: cursor | anthropic | openai | openrouter | google (comma-ok). Inferred from AGENT_CMD if unset.
# AGENT_EGRESS_PROFILE=cursor
# Optional full host allowlist override (comma-separated):
# LEMMA_EGRESS_ALLOWLIST=

# Pipeline logging: OFF | ERROR | WARN | INFO | DEBUG | TRACE
LEMMA_LOG_LEVEL=INFO

# Research harvest: 1 = timestamped research_loop/runs/<id>/ (workspace+logs+history).
# Off by default for local tweaking; turn on for GCP / serious experiments.
LEMMA_RESEARCH_LOG=0

# Primary optimization metric for H1 path agents: SESSION_HOT_US (GenDB hot recompute).
